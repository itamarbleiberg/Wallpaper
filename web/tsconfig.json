{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@engine/*": ["../src/engine/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "//": "Only the web sources are included. Engine/shared files are type-checked where imported via the aliases; this deliberately excludes the desktop-only ../src/shared/ipc.ts (which imports Tauri).",
  "include": ["src"]
}
